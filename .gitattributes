# Keep release tarballs / Packagist downloads lean: exclude development
# tooling, tests, documentation, and CI metadata from `composer install`.
# Keep assets/package.json and assets/dist/ — Symfony UX needs them at install.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/assets/biome.json export-ignore
/assets/scripts export-ignore
/assets/src export-ignore
/assets/test export-ignore
/assets/tsconfig.json export-ignore
/assets/vitest.config.ts export-ignore
/codecov.yml export-ignore
/docs export-ignore
/phpunit.xml.dist export-ignore
/skills export-ignore
/tests export-ignore
