---
import Layout from './Layout.astro'
import OnThisPage from '../components/OnThisPage.astro'
import DocPagination from '../components/DocPagination.astro'
import CopyCode from '../components/CopyCode.astro'
import { docsSidebarSections, getAdjacentPages } from '../config/navigation'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  description?: string
  headings?: Heading[]
  editUrl?: string
}

const { title, description, headings = [], editUrl } = Astro.props
const pathname = Astro.url.pathname
const { prev, next } = getAdjacentPages(pathname)

const SidebarNav = docsSidebarSections
---

<Layout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 py-8 lg:flex-row">
      <!-- Mobile drawer -->
      <div
        id="docs-mobile-nav"
        class="fixed inset-0 z-50 hidden"
        data-mobile-nav
        aria-hidden="true"
      >
        <button
          type="button"
          class="absolute inset-0 bg-black/50"
          data-mobile-nav-close
          aria-label="Close navigation"
        ></button>
        <aside
          class="absolute top-0 left-0 flex h-full w-[min(20rem,88vw)] flex-col overflow-y-auto border-r border-slate-200 bg-white p-6 shadow-xl dark:border-slate-800 dark:bg-[#0a1628]"
        >
          <div class="mb-6 flex items-center justify-between">
            <span class="text-lg font-bold text-slate-900 dark:text-white">Docs</span>
            <button
              type="button"
              class="rounded border border-slate-300 px-2 py-1 text-sm dark:border-slate-700"
              data-mobile-nav-close
            >
              Close
            </button>
          </div>
          <nav class="space-y-8" aria-label="Mobile documentation">
            {
              SidebarNav.map((section) => (
                <div>
                  <h3 class="mb-3 text-sm font-semibold tracking-wider text-slate-600 uppercase dark:text-slate-500">
                    {section.label}
                  </h3>
                  <ul class="space-y-2">
                    {section.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class:list={[
                            'block border-l-2 pl-4 text-sm transition-colors',
                            pathname === item.href
                              ? 'border-blue-500 text-slate-900 dark:text-white'
                              : 'border-transparent text-slate-600 dark:text-slate-400 hover:border-blue-500 hover:text-slate-900 dark:hover:text-white',
                          ]}
                        >
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
        </aside>
      </div>

      <!-- Desktop sidebar -->
      <aside class="hidden w-64 shrink-0 lg:block">
        <nav
          class="sticky top-24 max-h-[calc(100vh-7rem)] space-y-8 overflow-y-auto pb-8"
          aria-label="Documentation"
        >
          {
            SidebarNav.map((section) => (
              <div>
                <h3 class="mb-3 text-sm font-semibold tracking-wider text-slate-600 uppercase dark:text-slate-500">
                  {section.label}
                </h3>
                <ul class="space-y-2">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          'block border-l-2 pl-4 text-sm transition-colors',
                          pathname === item.href
                            ? 'border-blue-500 text-slate-900 dark:text-white'
                            : 'border-transparent text-slate-600 dark:text-slate-400 hover:border-blue-500 hover:text-slate-900 dark:hover:text-white',
                        ]}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <!-- Content -->
      <div class="min-w-0 flex-grow">
        {
          editUrl && (
            <div class="mb-4 flex justify-end">
              <a
                href={editUrl}
                class="text-xs font-medium tracking-wide text-slate-500 uppercase transition-colors hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400"
                target="_blank"
                rel="noopener noreferrer"
              >
                Edit on GitHub
              </a>
            </div>
          )
        }
        <article class="prose prose-blue dark:prose-invert max-w-none">
          <slot />
        </article>
        <DocPagination prev={prev} next={next} />
      </div>

      <OnThisPage headings={headings} />
    </div>
  </div>
  <CopyCode />
</Layout>

<style is:global>
  @reference '../styles/global.css';
  .prose h1 {
    @apply mb-8 text-4xl;
  }
  .prose h2 {
    @apply mt-12 mb-6 border-b border-slate-200 pb-2 text-2xl dark:border-slate-800;
  }
  .prose h3 {
    @apply mt-8 mb-4 text-xl;
  }

  .prose h2,
  .prose h3,
  .prose h4 {
    position: relative;
    scroll-margin-top: 5rem;
  }
  .prose .heading-anchor {
    @apply ml-2 font-normal text-slate-400 no-underline opacity-0 transition-opacity dark:text-slate-600;
  }
  .prose h2:hover .heading-anchor,
  .prose h3:hover .heading-anchor,
  .prose h4:hover .heading-anchor {
    @apply opacity-100;
  }
  .prose .heading-anchor:hover {
    @apply text-blue-400;
  }
  .prose p {
    @apply mb-4 leading-relaxed text-slate-600 dark:text-slate-400;
  }
  .prose code {
    @apply rounded bg-slate-200 px-1.5 py-0.5 font-mono text-sm text-blue-700 dark:bg-slate-800 dark:text-blue-300;
  }
  .prose pre {
    @apply my-6 overflow-x-auto rounded-lg border border-slate-800 bg-slate-900 p-4;
  }
  .prose pre code {
    @apply bg-transparent p-0 text-slate-300;
  }
  .prose ul {
    @apply mb-4 list-inside list-disc space-y-2 text-slate-600 dark:text-slate-400;
  }
  .prose ol {
    @apply mb-4 list-inside list-decimal space-y-2 text-slate-600 dark:text-slate-400;
  }
  .prose strong {
    @apply font-semibold text-slate-900 dark:text-white;
  }
  .prose a {
    @apply text-blue-600 underline decoration-slate-300 underline-offset-4 transition-all hover:text-blue-700 hover:decoration-blue-400 dark:text-blue-400 dark:decoration-slate-700 dark:hover:text-blue-300;
  }
  .prose table {
    @apply my-6 w-full text-left text-sm;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .prose thead tr {
    @apply bg-slate-100 dark:bg-slate-900/70;
  }
  .prose th {
    @apply border-b border-slate-300 px-4 py-3 font-semibold text-slate-900 dark:border-slate-700 dark:text-slate-100;
  }
  .prose td {
    @apply border-b border-slate-200 px-4 py-3 align-top text-slate-700 dark:border-slate-800 dark:text-slate-300;
  }
  .prose tbody tr:nth-child(even) {
    @apply bg-slate-100/60 dark:bg-slate-900/30;
  }
  .prose tbody tr:hover {
    @apply bg-blue-500/10;
  }

  aside nav::-webkit-scrollbar {
    width: 4px;
  }
  aside nav::-webkit-scrollbar-track {
    background: transparent;
  }
  aside nav::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 2px;
  }
  aside nav {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }
  .dark aside nav::-webkit-scrollbar-thumb {
    background: #1e293b;
  }
  .dark aside nav {
    scrollbar-color: #1e293b transparent;
  }

  html[data-mobile-nav-open] #docs-mobile-nav {
    display: block;
  }
</style>
