---
interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
---

{
  toc.length > 1 && (
    <nav class="hidden w-52 shrink-0 xl:block" aria-label="On this page">
      <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-8">
        <p class="mb-3 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-500">
          On this page
        </p>
        <ul class="space-y-2 border-l border-slate-200 dark:border-slate-800">
          {toc.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  'block border-l-2 border-transparent py-0.5 text-sm text-slate-500 transition-colors hover:border-blue-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white',
                  heading.depth === 3 ? 'pl-6' : 'pl-3',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}
