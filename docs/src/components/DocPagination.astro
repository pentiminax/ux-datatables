---
import type { NavItem } from '../config/navigation'

interface Props {
  prev: NavItem | null
  next: NavItem | null
}

const { prev, next } = Astro.props
---

{
  (prev || next) && (
    <nav
      class="mt-14 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2 dark:border-slate-800"
      aria-label="Pagination"
    >
      {prev ? (
        <a
          href={prev.href}
          class="group rounded-lg border border-slate-200 bg-white p-4 transition-colors hover:border-blue-500 dark:border-slate-800 dark:bg-[#0a1628]"
        >
          <span class="text-xs tracking-wide text-slate-500 uppercase dark:text-slate-400">Previous</span>
          <span class="mt-1 block font-medium text-slate-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
            {prev.label}
          </span>
        </a>
      ) : (
        <div />
      )}
      {next ? (
        <a
          href={next.href}
          class="group rounded-lg border border-slate-200 bg-white p-4 text-right transition-colors hover:border-blue-500 dark:border-slate-800 dark:bg-[#0a1628] sm:justify-self-end"
        >
          <span class="text-xs tracking-wide text-slate-500 uppercase dark:text-slate-400">Next</span>
          <span class="mt-1 block font-medium text-slate-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
            {next.label}
          </span>
        </a>
      ) : null}
    </nav>
  )
}
