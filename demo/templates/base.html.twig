{% set current = demo_page() %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ current ? ('page.' ~ current.route ~ '.title')|trans ~ ' · ' }}UX DataTables Demo{% endblock %}</title>
        <meta name="description" content="{{ 'meta.description'|trans }}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%227%22 fill=%22%234a46c4%22/><path d=%22M8 11h16M8 16h16M8 21h16M14 8v16%22 stroke=%22white%22 stroke-width=%222%22/></svg>">
        <script>
            try {
                const theme = localStorage.getItem('demo-theme')
                if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
            } catch (error) {
                console.warn('Stored theme unavailable; following the system theme.', error)
            }
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@600;700&family=JetBrains+Mono:wght@400;500&family=Source+Sans+3:wght@400;600;700&display=swap">
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#main">{{ 'nav.skip'|trans }}</a>

        <header class="topbar">
            <button class="icon-button nav-toggle" type="button" popovertarget="sidebar" aria-label="{{ 'nav.open'|trans }}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>

            <a class="brand" href="{{ path('overview') }}">
                <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M9.5 9.5V20"/></svg>
                <span>UX DataTables <span class="brand-suffix">Demo</span></span>
            </a>

            <div class="topbar-actions">
                <nav class="locale-switch" aria-label="{{ 'nav.language'|trans }}">
                    {% for locale in ['en', 'fr'] %}
                        <a href="{{ path(app.current_route, app.current_route_parameters|merge({_locale: locale})) }}"
                           hreflang="{{ locale }}" lang="{{ locale }}"
                           {% if locale == app.request.locale %}aria-current="true"{% endif %}>{{ locale|upper }}</a>
                    {% endfor %}
                </nav>

                <button class="icon-button" type="button" data-controller="theme" data-action="theme#toggle" aria-label="{{ 'nav.theme'|trans }}">
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
                </button>

                <form method="post" action="{{ path('reset') }}" class="reset-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('reset-demo') }}">
                    <input type="hidden" name="page" value="{{ current ? current.route : 'overview' }}">
                    <button class="button button-quiet" type="submit">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>{{ 'nav.reset'|trans }}</span>
                    </button>
                </form>

                <a class="icon-button" href="https://github.com/pentiminax/ux-datatables" aria-label="GitHub">
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="filled"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
                </a>
            </div>
        </header>

        <div class="shell">
            <nav id="sidebar" class="sidebar" popover aria-label="{{ 'nav.label'|trans }}">
                {% for group, pages in demo_navigation() %}
                    <section class="nav-group">
                        <h2 class="nav-heading">{{ ('group.' ~ group)|trans }}</h2>
                        <ul>
                            {% for page in pages %}
                                <li>
                                    <a href="{{ path(page.route) }}" {% if current and current.route == page.route %}aria-current="page"{% endif %}>
                                        {{ ('page.' ~ page.route ~ '.title')|trans }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}
                <a class="nav-docs" href="{{ constant('App\\Demo\\Pages::DOCS') }}">{{ 'nav.docs'|trans }} <span aria-hidden="true">↗</span></a>
            </nav>

            <main id="main" class="main">
                {% for message in app.flashes('success') %}
                    <p class="flash" role="status">{{ message|trans }}</p>
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
