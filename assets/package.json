  "scripts": {
    "build": "tsc && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "lint": "biome lint src/",
