{
  "name": "@pentiminax/ux-datatables",
  "description": "DataTables integration for Symfony",
  "license": "MIT",
  "version": "1.5.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "symfony": {
    "controllers": {
      "datatable": {
        "main": "dist/controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true,
        "autoimport": {
          "@pentiminax/ux-datatables/dist/styles/datatables-base-style.css": true,
          "@pentiminax/ux-datatables/dist/styles/datatables-tailwind-theme.css": false,
          "datatables.net-dt/css/dataTables.dataTables.min.css": true,
          "datatables.net-bs5/css/dataTables.bootstrap5.min.css": false
        }
      },
      "datatable_core": {
        "main": "dist/core.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": false,
        "autoimport": {
          "@pentiminax/ux-datatables/dist/styles/datatables-base-style.css": true,
