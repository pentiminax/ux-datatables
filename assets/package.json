{
  "name": "@pentiminax/ux-datatables",
  "description": "DataTables integration for Symfony",
  "license": "MIT",
  "version": "1.5.1",
  "type": "module",
  "main": "dist/core.js",
  "types": "dist/core.d.ts",
  "symfony": {
    "controllers": {
      "datatable": {
        "main": "dist/core.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true,
        "autoimport": {
          "@pentiminax/ux-datatables/dist/styles/datatables-base-style.css": true,
          "@pentiminax/ux-datatables/dist/styles/datatables-tailwind-theme.css": true,
          "datatables.net-dt/css/dataTables.dataTables.min.css": true,
          "datatables.net-bs5/css/dataTables.bootstrap5.min.css": false
        }
      },
      "datatable_core": {
        "main": "dist/core.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": false,
        "autoimport": {
          "@pentiminax/ux-datatables/dist/styles/datatables-base-style.css": true,
          "@pentiminax/ux-datatables/dist/styles/datatables-tailwind-theme.css": true,
          "datatables.net-dt/css/dataTables.dataTables.min.css": true,
          "datatables.net-bs5/css/dataTables.bootstrap5.min.css": false
        }
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "bootstrap": "^5.3.8",
    "datatables.net-bs5": "^3.1.3",
    "datatables.net-buttons": "^4.1.2",
    "datatables.net-buttons-bs5": "^4.1.3",
    "datatables.net-buttons-dt": "^4.1.2",
    "datatables.net-colreorder-bs5": "^3.1.2",
    "datatables.net-colreorder-dt": "^3.1.2",
    "datatables.net-columncontrol-bs5": "^2.1.3",
    "datatables.net-columncontrol-dt": "^2.1.2",
    "datatables.net-datetime": "^2.1.3",
    "datatables.net-dt": "^3.1.3",
    "datatables.net-fixedcolumns-bs5": "^6.1.2",
    "datatables.net-fixedcolumns-dt": "^6.1.1",
    "datatables.net-fixedheader-bs5": "^5.1.2",
    "datatables.net-fixedheader-dt": "^5.1.2",
